# Plantilla: no contiene secretos. Variables configuradas en el hosting.
NODE_ENV=production
HOST=0.0.0.0
# Railway proporciona PORT; en otros hosts configurarlo.
# PORT=3000
PUBLIC_ORIGIN=https://tu-dominio.example
DATABASE_URL=postgresql://USUARIO:CLAVE@SERVIDOR:5432/BASE
# disable para una conexión privada local; verify-full si el proveedor exige TLS.
DB_SSL_MODE=disable
# DB_SSL_CA=
# Copiar en privado la clave EXISTENTE (32 bytes base64). No generar otra al migrar.
PASSWORD_ENCRYPTION_KEY=
